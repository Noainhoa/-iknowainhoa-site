SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=

# Supabase (Parking Guardamar Centro)
# Either publishable or anon key works (same public client key from the dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only parking key if needed. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Tech Made Easy — isolated project; never reuse parking/life URLs)
NEXT_PUBLIC_TECH_SUPABASE_URL=
NEXT_PUBLIC_TECH_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_TECH_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never fall back to parking service role.
# TECH_SUPABASE_SERVICE_ROLE_KEY=
# Optional owner inbox for booking notifications. Falls back to CONTACT_TO, then SMTP_USER.
# TECH_NOTIFY_EMAIL=

# Supabase (Life — ainhoa-life project)
NEXT_PUBLIC_LIFE_SUPABASE_URL=
NEXT_PUBLIC_LIFE_SUPABASE_PUBLISHABLE_KEY=

# OpenAI (Life OS inbox processing + NOA — server-side only)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Maps / Places (Life location picker — browser key, restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
